<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PhilanthropicPhyllonycteris</AssemblyName>
    <RootNamespace>PhilanthropicPhyllonycteris</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PhilanthropicPhyllonycteris.Core/PhilanthropicPhyllonycteris.Core.csproj" />
  </ItemGroup>

  <!-- BepInEx and Harmony, from the BepInEx install in the game folder -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity and game assemblies, referenced in place and never copied -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sunless.Game">
      <HintPath>$(GameManagedDir)/Sunless.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Failbetter.Core">
      <HintPath>$(GameManagedDir)/Failbetter.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The version comes from the git tag (MinVer, see Directory.Build.props). This writes it into a generated
       PluginInfo class so the BepInPlugin attribute and the log line can never drift from the tag. -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile" DependsOnTargets="MinVer">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <PluginInfoLine Include="// &lt;auto-generated /&gt;" />
      <PluginInfoLine Include="// Written by the GeneratePluginInfo target in $(MSBuildProjectFile) from the git tag. Do not edit." />
      <PluginInfoLine Include="namespace $(RootNamespace)%3B" />
      <PluginInfoLine Include="internal static class PluginInfo" />
      <PluginInfoLine Include="{" />
      <PluginInfoLine Include="%20%20%20%20/// &lt;summary&gt;Major.minor.patch only, as BepInEx requires of a plugin version.&lt;/summary&gt;" />
      <PluginInfoLine Include="%20%20%20%20public const string Version = &quot;$(MinVerMajor).$(MinVerMinor).$(MinVerPatch)&quot;%3B" />
      <PluginInfoLine Include="%20%20%20%20/// &lt;summary&gt;The whole version, with the pre-release suffix an untagged build carries.&lt;/summary&gt;" />
      <PluginInfoLine Include="%20%20%20%20public const string FullVersion = &quot;$(MinVerVersion)&quot;%3B" />
      <PluginInfoLine Include="}" />
      <Compile Include="$(PluginInfoFile)" />
    </ItemGroup>
    <!-- A design-time build in an IDE may reach here without MinVer having run; it must not blank the file -->
    <WriteLinesToFile File="$(PluginInfoFile)" Lines="@(PluginInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'$(MinVerVersion)' != ''" />
  </Target>

  <!-- Drop the built plugin straight into BepInEx/plugins/PhilanthropicPhyllonycteris for the dev loop.
       Skipped by the release tool (-p:CopyToPlugins=false) so a release build never touches the live game folder. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CopyToPlugins)' != 'false'">
    <PropertyGroup>
      <PluginOutDir>$(BepInExPluginsDir)/$(AssemblyName)</PluginOutDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <!-- The Core library ships alongside the plugin; BepInEx resolves it from the same folder -->
      <PluginFiles Include="$(TargetDir)PhilanthropicPhyllonycteris.Core.dll" />
      <PluginFiles Include="$(TargetDir)PhilanthropicPhyllonycteris.Core.pdb" Condition="Exists('$(TargetDir)PhilanthropicPhyllonycteris.Core.pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="PhilanthropicPhyllonycteris -> $(PluginOutDir)" />
  </Target>

</Project>
