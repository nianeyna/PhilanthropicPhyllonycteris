<Project>

  <!-- Location of the Sunless Sea install. Override with an env var:
         SUNLESS_SEA_DIR=/path/to/SunlessSea dotnet build
       or on the command line:
         dotnet build -p:GameDir=/path/to/SunlessSea -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(SUNLESS_SEA_DIR)' != ''">$(SUNLESS_SEA_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/SunlessSea</GameDir>
    <GameManagedDir>$(GameDir)/Sunless Sea_Data/Managed</GameManagedDir>
    <BepInExCoreDir>$(GameDir)/BepInEx/core</BepInExCoreDir>
    <BepInExPluginsDir>$(GameDir)/BepInEx/plugins</BepInExPluginsDir>
  </PropertyGroup>

  <!-- Versions come from git tags (v1.2.3) via MinVer. An untagged commit builds as the next patch with a
       pre-release suffix, e.g. 0.2.1-alpha.0.3. MinVerMinimumMajorMinor only matters before the first tag,
       and afterwards to announce the next minor early. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
